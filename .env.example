# ==============================================================================
# RESUMATE AI - Environment Variables Example
# Duplicate this file as '.env' and fill in your actual credentials.
# Never commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Authentication Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# Obtain this from: Google AI Studio (https://aistudio.google.com/)
# Powered by the @google/genai SDK
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
